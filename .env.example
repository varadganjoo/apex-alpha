# Copy this file to .env.
# Committee models, tried in order on quota, overload, or unavailable-model errors.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash

# Backup when every Gemini model fails.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# SEC EDGAR needs no key, only a name and contact email in the User-Agent (SEC fair-access policy).
SEC_USER_AGENT=Apex-Alpha demo you@example.com

# Optional second price source if Yahoo Finance is unavailable (free key at tiingo.com).
TIINGO_API_KEY=

# Set to "sample" to use the offline sample dataset only.
APEX_DATA=live
